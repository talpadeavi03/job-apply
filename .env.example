# ==========================================
# AetherApply Environment Configuration Template
# ==========================================

# 1. Google Gemini API (Required for MCP AI question answering and cover letter generation)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Discord Webhook (Required for real-time alerts and application receipts)
# Obtain from Discord Channel Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# 3. Google OAuth 2.0 Credentials (For Gmail alert parsing and automated 2FA OTP retrieval)
# Obtain from Google Cloud Console > APIs & Services > Credentials
GMAIL_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REFRESH_TOKEN=your_oauth_refresh_token

# 4. LinkedIn Authentication (Choose credentials or session cookie)
LINKEDIN_USERNAME=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password
# Optional: Session cookie li_at (if not using username/password login)
LINKEDIN_LI_AT=

# 5. Naukri Authentication
NAUKRI_USERNAME=your_naukri_email@example.com
NAUKRI_PASSWORD=your_naukri_password
# Optional: Raw JWT token or cookies
NAUKRI_AT=
NAUKRI_COOKIES=

# 6. Database Connection (Optional - defaults to SQLite at data/aetherapply.sqlite3)
# PostgreSQL connection string (Neon / Supabase / AWS RDS):
DATABASE_URL=

# 7. Firebase Firestore Cloud Sync (Optional)
# Base64-encoded string of your serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=

# 8. Execution Limits
MAX_APPLY_PER_CYCLE=15
